                              />
                              <path
                                d="M18.5 18a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z"
                              />
                              <path
                                d="M12 12H3"
                              />
                              <path
                                d="M16 6H3"
                              />
                              <path
                                d="M12 18H3"
                              />
                            </svg>
                            Playlists
                          </h3>
                          <p
                            class="text-foreground/60 mb-3 text-sm"
                          >
                            Playlist sources let you import playlists from external services by URL.
                          </p>
                          <div
                            class="flex flex-wrap gap-2"
                          >
                            <span
                              class="border-border inline-flex items-center justify-center border-(length:--border-width) whitespace-nowrap rounded-full px-2 py-0.5 text-xs font-semibold surface-accent-green gap-1"
                              data-testid="provider-list-item"
                            >
                              <svg
                                aria-hidden="true"
                                class="lucide lucide-list-music"
                                fill="none"
                                height="10"
                                stroke="currentColor"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                viewBox="0 0 24 24"
                                width="10"
                                xmlns="http://www.w3.org/2000/svg"
                              >
                                <path
                                  d="M21 15V6"
                                />
                                <path
                                  d="M18.5 18a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z"
                                />
                                <path
                                  d="M12 12H3"
                                />
                                <path
                                  d="M16 6H3"
                                />
                                <path
                                  d="M12 18H3"
                                />
                              </svg>
                              Acme Playlists
                            </span>
                          </div>
                        </div>
                        <div
                          class="mb-6 px-2"
                          data-testid="sources-section-lyrics"
                        >
                          <h3
                            class="text-foreground mb-1 flex items-center gap-2 text-sm font-semibold"
                          >
                            <svg
                              aria-hidden="true"
                              class="lucide lucide-mic-vocal"
                              fill="none"
                              height="14"
                              stroke="currentColor"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              viewBox="0 0 24 24"
                              width="14"
                              xmlns="http://www.w3.org/2000/svg"
                            >
                              <path
                                d="m11 7.601-5.994 8.19a1 1 0 0 0 .1 1.298l.817.818a1 1 0 0 0 1.314.087L15.09 12"
                              />
                              <path
                                d="M16.5 21.174C15.5 20.5 14.372 20 13 20c-2.058 0-3.928 2.356-6 2-2.072-.356-2.775-3.369-1.5-4.5"
                              />
                              <circle
                                cx="16"
                                cy="7"
                                r="5"
                              />
                            </svg>
                            Lyrics
                          </h3>
                          <p
                            class="text-foreground/60 mb-3 text-sm"
                          >
                            Lyrics sources provide lyrics for the current track. Nuclear gets lyrics from all lyrics sources at the same time and shows the best result. You can select the lyrics of a different source in the Lyrics view.
                          </p>
                          <p
                            class="text-foreground/60 text-sm italic"
                            data-testid="no-providers-message"
                          >
                            No providers installed
                          </p>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </main>
      <div
        animate="[object Object]"
        class="border-border relative flex flex-col overflow-hidden surface-sidebar-right border-l-(length:--border-width)"
        data-testid="sidebar-right"
        transition="[object Object]"
      >
        <span
          class="mb-4 flex flex-row items-center justify-start px-2 pt-2"
        >
          <button
            class="inline-flex cursor-pointer items-center rounded-md whitespace-nowrap transition-all outline-none disabled:cursor-not-allowed disabled:opacity-50 surface-primary border-border shadow-shadow hover:translate-x-shadow-x hover:translate-y-shadow-y border-(length:--border-width) hover:shadow-none size-10 justify-center top-2 px-2 left-1"
            data-headlessui-state=""
            data-testid="sidebar-toggle-right"
            type="button"
          >
            <svg
              aria-hidden="true"
              class="lucide lucide-panel-right"
              fill="none"
              height="24"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              width="24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <rect
                height="18"
                rx="2"
                width="18"
                x="3"
                y="3"
              />
              <path
                d="M15 3v18"
              />
            </svg>
          </button>
          <span
            class="flex flex-1 items-center justify-end gap-1"
          />
        </span>
        <div
          class="flex flex-1 flex-col overflow-hidden px-2 pb-2"
        >
          <div
            class="flex h-full flex-col items-center justify-center gap-4 p-8 text-center transition-opacity duration-150 opacity-100"
            data-testid="queue-empty-state"
          >
            <svg
              aria-hidden="true"
              class="lucide lucide-music opacity-50"
              fill="none"
              height="64"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              width="64"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M9 18V5l12-2v13"
              />
              <circle
                cx="6"
                cy="18"
                r="3"
              />
              <circle
                cx="18"
                cy="16"
                r="3"
              />
            </svg>
            <div>
              <div
                class="text-lg font-bold"
              >
                Queue is empty
              </div>
              <div
                class="mt-2 text-sm opacity-70"
              >
                Add tracks to start playing
              </div>
            </div>
          </div>
        </div>
        <div
          class="absolute top-0 bottom-0 w-1 cursor-col-resize transition-colors left-0"
        />
      </div>
