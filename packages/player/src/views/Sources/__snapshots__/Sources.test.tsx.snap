      <main
        class="surface-muted min-w-0 max-w-full overflow-x-hidden overflow-y-auto"
        data-testid="player-workspace-main"
      >
        <div
          class="relative h-full w-full overflow-hidden"
        >
          <div
            animate="center"
            class="absolute inset-0 h-full w-full will-change-[transform,filter]"
            exit="exit"
            initial="enter"
            transition="[object Object]"
          >
            <div
              class="surface-background relative flex h-full min-h-0 w-full flex-1 flex-col items-start justify-start px-3 pt-3 md:px-6 md:pt-6"
              data-testid="sources-view"
            >
              <h1
                class="mb-3 flex w-full flex-0 flex-row text-center text-xl font-bold md:mb-6 md:text-3xl"
                data-testid="title"
              >
                Sources
              </h1>
              <div
                class="relative h-full flex min-h-0 w-full flex-1 flex-col"
              >
                <div
                  class="scrollbar-hide flex h-full w-full flex-col overflow-auto"
                  style="scrollbar-width: none;"
                >
                  <div
                    class="flex h-full w-full items-start justify-center"
                  >
                    <div
                      class="relative h-full w-full max-w-120 flex-1 gap-4 overflow-hidden"
                    >
                      <div
                        class="scrollbar-hide flex h-full w-full flex-col overflow-auto"
                        style="scrollbar-width: none;"
                      >
                        <div
                          class="mb-6 px-2"
                          data-testid="sources-section-metadata"
                        >
                          <h3
                            class="text-foreground mb-1 flex items-center gap-2 text-sm font-semibold"
                          >
                            <svg
                              aria-hidden="true"
                              class="lucide lucide-search"
                              fill="none"
                              height="14"
                              stroke="currentColor"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              viewBox="0 0 24 24"
                              width="14"
                              xmlns="http://www.w3.org/2000/svg"
                            >
                              <path
                                d="m21 21-4.34-4.34"
                              />
                              <circle
                                cx="11"
                                cy="11"
                                r="8"
                              />
                            </svg>
                            Metadata
                          </h3>
                          <p
                            class="text-foreground/60 mb-2 text-sm"
                          >
                            Metadata sources provide information about artists, albums, and tracks. Search results, artist pages, and album details come from the active metadata source.
                          </p>
                          <div
                            class="relative flex w-full flex-col gap-2"
                          >
                            <button
                              aria-expanded="false"
                              aria-haspopup="listbox"
                              class="border-border focus-visible:ring-ring focus-visible:ring-offset-muted relative flex w-full items-center justify-between rounded-md border-(length:--border-width) text-left transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none disabled:cursor-not-allowed disabled:opacity-50 surface-primary px-3 py-2 text-sm"
                              data-headlessui-state=""
                              id="select-:r3:"
                              type="button"
                            >
                              <span
                                class="flex min-w-0 items-center gap-2"
                              >
                                <span
                                  class="truncate"
                                >
                                  Acme Metadata
                                </span>
                              </span>
                              <span
                                class="flex items-center"
                              >
                                <svg
                                  aria-hidden="true"
                                  class="lucide lucide-chevron-down text-foreground transition-transform"
                                  fill="none"
                                  height="16"
                                  stroke="currentColor"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  viewBox="0 0 24 24"
                                  width="16"
                                  xmlns="http://www.w3.org/2000/svg"
                                >
                                  <path
                                    d="m6 9 6 6 6-6"
                                  />
                                </svg>
                              </span>
                            </button>
                          </div>
                        </div>
                        <div
                          class="mb-6 px-2"
                          data-testid="sources-section-streaming"
                        >
                          <h3
                            class="text-foreground mb-1 flex items-center gap-2 text-sm font-semibold"
                          >
                            <svg
                              aria-hidden="true"
                              class="lucide lucide-headphones"
                              fill="none"
                              height="14"
                              stroke="currentColor"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              viewBox="0 0 24 24"
                              width="14"
                              xmlns="http://www.w3.org/2000/svg"
                            >
                              <path
                                d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3"
                              />
                            </svg>
                            Streaming
                          </h3>
                          <p
                            class="text-foreground/60 mb-2 text-sm"
                          >
                            Streaming sources provide audio. When you play a track, the streaming source finds and delivers the audio stream.
                          </p>
                          <div
                            class="relative flex w-full flex-col gap-2"
                          >
                            <button
                              aria-expanded="false"
                              aria-haspopup="listbox"
                              class="border-border focus-visible:ring-ring focus-visible:ring-offset-muted relative flex w-full items-center justify-between rounded-md border-(length:--border-width) text-left transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none disabled:cursor-not-allowed disabled:opacity-50 surface-primary px-3 py-2 text-sm"
                              data-disabled=""
                              data-headlessui-state="disabled"
                              disabled=""
                              id="select-:ra:"
                              type="button"
                            >
                              <span
                                class="flex min-w-0 items-center gap-2"
                              >
                                <span
                                  class="truncate"
                                >
                                  Acme
                                </span>
                              </span>
                              <span
                                class="flex items-center"
                              >
                                <svg
                                  aria-hidden="true"
                                  class="lucide lucide-chevron-down text-foreground transition-transform"
                                  fill="none"
                                  height="16"
                                  stroke="currentColor"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  viewBox="0 0 24 24"
                                  width="16"
                                  xmlns="http://www.w3.org/2000/svg"
                                >
                                  <path
                                    d="m6 9 6 6 6-6"
                                  />
                                </svg>
                              </span>
                            </button>
                          </div>
                          <p
                            class="text-foreground/60 mt-4 text-sm leading-relaxed"
                            data-testid="locked-reason"
                          >
                            <span
                              class="border-border inline-flex items-center justify-center border-(length:--border-width) whitespace-nowrap rounded-full px-2 py-0.5 text-xs font-semibold surface-accent-yellow gap-1 mx-1 align-middle"
                            >
                              <svg
                                aria-hidden="true"
                                class="lucide lucide-search"
                                fill="none"
                                height="10"
                                stroke="currentColor"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                viewBox="0 0 24 24"
                                width="10"
                                xmlns="http://www.w3.org/2000/svg"
                              >
                                <path
                                  d="m21 21-4.34-4.34"
                                />
                                <circle
                                  cx="11"
                                  cy="11"
                                  r="8"
                                />
                              </svg>
                              Acme Metadata
                            </span>
                             metadata source requires 
                            <span
                              class="border-border inline-flex items-center justify-center border-(length:--border-width) whitespace-nowrap rounded-full px-2 py-0.5 text-xs font-semibold surface-accent-cyan gap-1 mx-1 align-middle"
                            >
                              <svg
                                aria-hidden="true"
                                class="lucide lucide-headphones"
                                fill="none"
                                height="10"
                                stroke="currentColor"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                viewBox="0 0 24 24"
                                width="10"
                                xmlns="http://www.w3.org/2000/svg"
                              >
                                <path
                                  d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3"
                                />
                              </svg>
                              Acme
                            </span>
                             streaming source.
                          </p>
                        </div>
                        <div
                          class="mb-6 px-2"
                          data-testid="sources-section-discovery"
                        >
                          <h3
                            class="text-foreground mb-1 flex items-center gap-2 text-sm font-semibold"
                          >
                            <svg
                              aria-hidden="true"
                              class="lucide lucide-boom-box"
                              fill="none"
                              height="14"
                              stroke="currentColor"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              viewBox="0 0 24 24"
                              width="14"
                              xmlns="http://www.w3.org/2000/svg"
                            >
                              <path
                                d="M4 9V5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v4"
                              />
                              <path
                                d="M8 8v1"
                              />
                              <path
                                d="M12 8v1"
                              />
                              <path
                                d="M16 8v1"
                              />
                              <rect
                                height="12"
                                rx="2"
                                width="20"
                                x="2"
                                y="9"
                              />
                              <circle
                                cx="8"
                                cy="15"
                                r="2"
                              />
                              <circle
                                cx="16"
                                cy="15"
                                r="2"
                              />
                            </svg>
                            Discovery
                          </h3>
                          <p
                            class="text-foreground/60 mb-2 text-sm"
                          >
                            Discovery sources recommend new tracks based on what you're listening to. Enable music discovery by using the boombox icon in the bottom bar.
                          </p>
                          <p
                            class="text-foreground/60 text-sm italic"
                            data-testid="no-providers-message"
                          >
                            No providers installed
                          </p>
                        </div>
                        <div
                          class="mb-6 px-2"
                          data-testid="sources-section-dashboard"
                        >
                          <h3
                            class="text-foreground mb-1 flex items-center gap-2 text-sm font-semibold"
                          >
                            <svg
                              aria-hidden="true"
                              class="lucide lucide-gauge"
                              fill="none"
                              height="14"
                              stroke="currentColor"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              viewBox="0 0 24 24"
                              width="14"
                              xmlns="http://www.w3.org/2000/svg"
                            >
                              <path
                                d="m12 14 4-4"
                              />
                              <path
                                d="M3.34 19a10 10 0 1 1 17.32 0"
                              />
                            </svg>
                            Dashboard
                          </h3>
                          <p
                            class="text-foreground/60 mb-3 text-sm"
                          >
                            Dashboard sources provide personalized content like top tracks, new releases, and recommendations on the home screen.
                          </p>
                          <div
                            class="flex flex-wrap gap-2"
                          >
                            <span
                              class="border-border inline-flex items-center justify-center border-(length:--border-width) whitespace-nowrap rounded-full px-2 py-0.5 text-xs font-semibold surface-accent-purple gap-1"
                              data-testid="provider-list-item"
                            >
                              <svg
                                aria-hidden="true"
                                class="lucide lucide-gauge"
                                fill="none"
                                height="10"
                                stroke="currentColor"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                viewBox="0 0 24 24"
                                width="10"
                                xmlns="http://www.w3.org/2000/svg"
                              >
                                <path
                                  d="m12 14 4-4"
                                />
                                <path
                                  d="M3.34 19a10 10 0 1 1 17.32 0"
                                />
                              </svg>
                              Acme Dashboard
                            </span>
                          </div>
                        </div>
                        <div
                          class="mb-6 px-2"
                          data-testid="sources-section-playlists"
                        >
                          <h3
                            class="text-foreground mb-1 flex items-center gap-2 text-sm font-semibold"
                          >
                            <svg
                              aria-hidden="true"
                              class="lucide lucide-list-music"
                              fill="none"
                              height="14"
                              stroke="currentColor"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              viewBox="0 0 24 24"
                              width="14"
                              xmlns="http://www.w3.org/2000/svg"
                            >
                              <path
